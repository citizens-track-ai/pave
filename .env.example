# Cloudflare R2 Configuration (for CDN-hosted images and attachments)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_token_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_token_secret_access_key
R2_BUCKET_NAME=pave-attachments
R2_JURISDICTION=eu                            # set to 'eu' if bucket was created in EU jurisdiction
R2_PUBLIC_URL=https://cdn.pavecasebook.org
R2_PREFIX=attachments                         # optional prefix in bucket (defaults to 'attachments')

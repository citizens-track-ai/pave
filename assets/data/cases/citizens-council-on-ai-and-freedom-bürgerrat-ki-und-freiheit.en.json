  "case_data": {
    "layout": "case",
    "title": "Citizens' Council on \"AI and Freedom\" (Bürgerrat \"KI und Freiheit\")",
    "airtable_id": "1da950a2c18a8d44",
    "slug": "citizens-council-on-ai-and-freedom-bürgerrat-ki-und-freiheit",
    "redirect_from": [
